.venv/
.venv-python*/
__pycache__/
*.py[cod]
.mplconfig/
*.egg-info/
build/
dist/
.DS_Store

# External compiler checkouts must remain separate from this repository.
liblsqecc/
lattice-surgery-compiler/
surface-code-floorplanner/

# Generated results: keep readable summaries and small reproducibility inputs.
# Large compilation/search bundles remain local.
outputs/compiler/
outputs/laplacian_inversion/*/runs/
outputs/laplacian_inversion/*/inputs/components/
outputs/mini_circuit/runs/
outputs/mini_circuit/artifacts/*
!outputs/mini_circuit/artifacts/EDPC.lli
!outputs/mini_circuit/artifacts/EDPC_sliced.lli
!outputs/mini_circuit/artifacts/compact.lli
!outputs/mini_circuit/artifacts/compact_sliced.lli
!outputs/mini_circuit/artifacts/annealed.lli
!outputs/mini_circuit/artifacts/annealed_sliced.lli
!outputs/mini_circuit/artifacts/annealed_layout/
outputs/mini_circuit/artifacts/annealed_layout/*
!outputs/mini_circuit/artifacts/annealed_layout/layout.txt
!outputs/mini_circuit/artifacts/annealed_layout/layout.svg
!outputs/mini_circuit/artifacts/annealed_layout/identity.json
!outputs/mini_circuit/artifacts/annealed_layout/original-circuit.qasm
!outputs/mini_circuit/artifacts/annealed_layout/mapped-circuit.qasm
!outputs/mini_circuit/artifacts/annealed_layout/resources.json
!outputs/mini_circuit/artifacts/annealed_layout/result.json
!outputs/mini_circuit/artifacts/annealed_layout/replay.json

# Optional Qiskit-export metadata; generated alongside the editable input.
tools/lattice_surgery/*.synthesis.json
